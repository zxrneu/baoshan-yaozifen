# 保山幺子分 - 环境变量示例配置
# 复制此文件为 .env 或在启动时注入：
# cp .env.example .env

# ----------------------------------------------------
# 1. 前端环境变量 (VITE_* 暴露给浏览器构建)
# ----------------------------------------------------

# 开发者上帝模式（透视手牌与全明手调试工具开关）
# 默认: false (关闭以保证正常公平竞技体验，开发调试可设为 true)
VITE_ENABLE_GOD_MODE=false

# LLM 请求默认并发上限（正整数，默认 2）
# 控制同时发往 LLM 服务端的请求数；显式传入 LlmEngineOptions.maxConcurrency 时以后者为准。
# 必须走 VITE_ 前缀在构建期注入——浏览器运行时没有 Node 的 process.env。
VITE_LLM_MAX_CONCURRENCY=2

# ----------------------------------------------------
# 2. Node 模型代理与决策服务配置 (server/proxy.ts)
# ----------------------------------------------------

# 服务监听端口与主机
PORT=3001
HOST=0.0.0.0

# 大语言模型配置 (OpenAI / vLLM / DeepSeek 协议兼容)
# 本地或私有 GPU 服务器部署地址
LLM_BASE_URL=http://127.0.0.1:8000/v1
# API 鉴权密钥 (直连第三方服务时使用，如 sk-...)
LLM_API_KEY=
# 模型标识名 (如 qwen38_27b / deepseek-chat)
LLM_MODEL=qwen38_27b
# 协议类型 (chat 或 completion)
LLM_PROTOCOL=chat
# 超时时间 (毫秒，默认 8000)
LLM_TIMEOUT_MS=8000

# 非自回归小模型配置 (TypeSafe / Ollaya 协议兼容)
LAYA_BASE_URL=http://127.0.0.1:11435
LAYA_API_KEY=
LAYA_MODEL=laya:multilingual
LAYA_TIMEOUT_MS=2500

# ----------------------------------------------------
# 3. 历史库配置 (P0.1：SQLite 历史协议与存储层)
# ----------------------------------------------------

# 对局历史 SQLite 文件路径（相对仓库根目录或绝对路径）
# 留空则回退到默认值 data/history.db；首次打开时自动建表并跑迁移。
GAME_DB_PATH=data/history.db

# 历史库总开关。设为 off/0/false/no/disabled 时完全关闭历史写入，
# 此时 openHistoryRepository() 返回 null，对局照常进行（无库可用不是错误）。
GAME_HISTORY=on

# ----------------------------------------------------
# 4. 版本化引擎配置实例 (P2)
# ----------------------------------------------------
# 留空：将上述单配置迁移为 default-bridge/algorithm/llm/laya。
# 使用模板：cp engine-profiles.example.json engine-profiles.json
# 再设置 ENGINE_PROFILES_PATH=engine-profiles.json，修改模板中的模型名并重启服务。
ENGINE_PROFILES_PATH=
# 第二组服务。公网地址和密钥只写此文件，JSON 仅存环境变量名。
LLM_ALT_BASE_URL=http://127.0.0.1:8001/v1
LLM_ALT_API_KEY=
LAYA_ALT_BASE_URL=http://127.0.0.1:11436
LAYA_ALT_API_KEY=
