{
  "name": "baoshan-yaozifen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "保山幺子分 —— 云南保山四人搭档吃分纸牌游戏的开源实现（React + TypeScript）",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxrneu/baoshan-yaozifen.git"
  },
  "bugs": {
    "url": "https://github.com/zxrneu/baoshan-yaozifen/issues"
  },
  "scripts": {
    "dev": "pnpm --filter @yaozifen/web dev",
    "client": "pnpm --filter @yaozifen/web client",
    "server": "pnpm --filter @yaozifen/server dev",
    "proxy": "pnpm --filter @yaozifen/server dev",
    "build": "pnpm typecheck && pnpm -r --workspace-concurrency=1 --if-present bundle",
    "preview": "pnpm --filter @yaozifen/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "eval:llm": "vite-node scripts/evaluate-llm-scenarios.ts",
    "eval:engines": "vite-node scripts/evaluate-engines.ts",
    "eval:coverage": "vite-node scripts/evaluate-scenario-coverage.ts",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:android": "tauri android build --debug",
    "app:ios": "tauri ios build",
    "start": "pnpm --filter @yaozifen/server start"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "happy-dom": "^21.0.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-node": "^3.2.0",
    "vitest": "^3.2.0",
    "@yaozifen/web": "workspace:*",
    "@yaozifen/server": "workspace:*",
    "@yaozifen/ai-core": "workspace:*",
    "@yaozifen/ai-eval": "workspace:*",
    "@yaozifen/game-core": "workspace:*",
    "@yaozifen/game-view": "workspace:*",
    "@yaozifen/history-core": "workspace:*",
    "@yaozifen/match-runtime": "workspace:*",
    "@yaozifen/protocol": "workspace:*",
    "@types/node": "^26.6.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
