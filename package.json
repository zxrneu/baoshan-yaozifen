{
  "name": "baoshan-yaozifen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "保山幺子分 —— 云南保山四人搭档吃分纸牌游戏的开源实现（React + TypeScript）",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxrneu/baoshan-yaozifen.git"
  },
  "bugs": {
    "url": "https://github.com/zxrneu/baoshan-yaozifen/issues"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/check-node-sqlite.mjs",
    "client": "vite --mode client",
    "server": "vite-node server/proxy.ts",
    "preserver": "node scripts/check-node-sqlite.mjs",
    "proxy": "vite-node server/proxy.ts",
    "preproxy": "node scripts/check-node-sqlite.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:llm": "vite-node scripts/evaluate-llm-scenarios.ts",
    "eval:engines": "vite-node scripts/evaluate-engines.ts",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:android": "tauri android build --debug",
    "app:ios": "tauri ios build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "openai": "^7.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "happy-dom": "^21.0.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-node": "^3.2.0",
    "vitest": "^3.2.0"
  }
}
